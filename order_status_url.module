<?php

/**
 * @file
 * Contains hooks for the Order Status URL module.
 */

use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function order_status_url_theme($existing, $type, $theme, $path) {
  return [
    'order_status_page' => [
      'variables' => [
        'order' => NULL,
        'status_label' => NULL,
      ],
      'template' => 'order-status-page',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_order_status_page().
 */
function order_status_url_theme_suggestions_order_status_page(array $variables) {
  $suggestions = [];
  /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
  if (!empty($variables['order']) && $variables['order'] instanceof OrderInterface) {
    $suggestions[] = 'order_status_page__' . $variables['order']->bundle();
  }
  return $suggestions;
}

/**
 * Implements hook_token_info().
 *
 * Adds a token under the existing 'commerce_order' token type (provided
 * by the Token module's automatic entity token support) so the guest
 * order status URL can be inserted into order receipt emails or any
 * other token-aware field without custom code.
 */
function order_status_url_token_info() {
  $info['tokens']['commerce_order']['order-status-url'] = [
    'name' => t('Order status URL'),
    'description' => t('The absolute URL of the guest order status lookup page for this order (requires the Order Status URL module).'),
  ];

  return $info;
}

/**
 * Implements hook_tokens().
 */
function order_status_url_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];

  if ($type !== 'commerce_order' || empty($data['commerce_order'])) {
    return $replacements;
  }

  /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
  $order = $data['commerce_order'];

  foreach ($tokens as $name => $original) {
    if ($name === 'order-status-url') {
      $url = Url::fromRoute('order_status_url.guest_order_status', [
        'uuid' => $order->uuid(),
      ], ['absolute' => TRUE]);

      $bubbleable_metadata->addCacheableDependency($order);
      $bubbleable_metadata->addCacheTags(['config:order_status_url.settings']);

      $replacements[$original] = $url->toString();
    }
  }

  return $replacements;
}

/**
 * Implements hook_preprocess_commerce_order_receipt().
 *
 * Supplies 'order_status_url' so a theme's commerce-order-receipt.html.twig
 * (or a block-override child template extending it) can render a link
 * inside the 'additional_information' block, rather than the link only
 * being appendable after the whole receipt via hook_mail_alter().
 *
 * Guest orders only; registered customers already have
 * /user/{user}/orders/{commerce_order}.
 */
function order_status_url_preprocess_commerce_order_receipt(&$variables) {
  $order = $variables['order_entity'] ?? NULL;

  if (!$order instanceof OrderInterface) {
    return;
  }

  if ((int) $order->getCustomerId() !== 0) {
    return;
  }

  $variables['order_status_url'] = \Drupal::token()->replace(
    '[commerce_order:order-status-url]',
    ['commerce_order' => $order]
  );
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Points the 'commerce_order_receipt' theme hook at this module's own
 * templates/commerce-order-receipt.html.twig (a block override adding
 * the guest order status link), so the receipt email picks up the
 * link without requiring any theme-level template file.
 *
 * If the active theme (or a base theme) already provides its own
 * commerce-order-receipt.html.twig, Drupal's normal theme registry
 * building will have already pointed this hook's 'path' at that
 * theme's templates directory by the time this hook runs. In that
 * case we deliberately do nothing, so a theme override always takes
 * precedence over this module's copy.
 */
function order_status_url_theme_registry_alter(&$theme_registry) {
  if (empty($theme_registry['commerce_order_receipt'])) {
    return;
  }

  $info = &$theme_registry['commerce_order_receipt'];

  /** @var \Drupal\Core\Extension\ModuleExtensionList $module_list */
  $module_list = \Drupal::service('extension.list.module');
  $commerce_order_templates_path = $module_list->getPath('commerce_order') . '/templates';

  // If 'path' no longer points at commerce_order's own templates
  // directory, something else (almost certainly a theme) has already
  // overridden this template. Don't clobber that.
  if (!isset($info['path']) || $info['path'] !== $commerce_order_templates_path) {
    return;
  }

  $info['path'] = $module_list->getPath('order_status_url') . '/templates';

  // The theme registry caches file paths and mtimes per hook; make
  // sure our override's timestamp is included so cache invalidation
  // still works correctly if this template is edited.
  $info['template'] = 'commerce-order-receipt';
}
